# Дерево зависимостей уже стоит на react 19, а часть пакетов (graphiql,
# @reduxjs/toolkit 1.x, @headlessui/react) объявляет peer только до react 18.
# package-lock.json собран в этом режиме, поэтому без флага `npm ci` падает
# с ERESOLVE. Файл коммитится, чтобы CI и локальная установка совпадали.
legacy-peer-deps=true

# В CI это лишний шум и лишние сетевые запросы.
fund=false
audit=false
