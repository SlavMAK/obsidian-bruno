{
  "name": "bruno-obsidian",
  "displayName": "Bruno for Obsidian",
  "description": "Bruno API client inside Obsidian",
  "version": "0.1.0",
  "license": "MIT",
  "keywords": [
    "Bruno",
    "API Client",
    "GraphQL",
    "gRPC",
    "HTTP",
    "REST",
    "Testing",
    "Bruno API",
    "Postman",
    "Thunder Client"
  ],
  "main": "main.js",
  "scripts": {
    "build": "npm run build:webview && npm run build:main",
    "build:main": "node esbuild.main.mjs",
    "build:webview": "rsbuild build -c rsbuild.webview.config.mjs",
    "dev": "node esbuild.main.mjs --watch",
    "dev:webview": "rsbuild build -c rsbuild.webview.config.mjs --watch",
    "typecheck": "tsc -p tsconfig.obsidian.json --noEmit",
    "test:smoke": "node test/build-and-run.mjs",
    "test:load": "node test/load.cjs",
    "test:webview": "node test/webview-unpack.mjs",
    "test": "npm run test:load && npm run test:webview && npm run test:smoke"
  },
